{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "./bin/executable.elf",
            "name": "Debug with JLink",
            "request": "launch",
            "type": "cortex-debug",
            "device": "",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "jlink"
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "jlink",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "build\\Debug\\basic_framework.elf",
            "runToEntryPoint": "main",
            "device": "STM32F407IG",
            "toolchainPrefix": "arm-none-eabi",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "attach",
            "name": "jlink-attach",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "build\\Debug\\basic_framework.elf",
            "runToEntryPoint": "main",
            "device": "STM32F407IG",
            "toolchainPrefix": "arm-none-eabi",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "Cortex Debug with STLink",
            "servertype": "openocd",
            "interface": "swd",
            "executable": "build\\Debug\\basic_framework.elf",
            "device": "STM32F407IG",
            "toolchainPrefix": "arm-none-eabi",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "svdFile": "./STM32F407.svd"
        }
    ]
}